# Tracked WebUI settings (non-secret). Loaded by compose env_file before override.env.
# The LiteLLM gateway secret (HARBOR_OPENAI_KEYS) lives in the UNTRACKED override.env.
# RAG embedding: cpu variant (identical weights to gpu, 2560-dim, Q4_K_M).
# WebUI reads RAG_EMBEDDING_MODEL from env at query time; must match config.override.json.

RAG_EMBEDDING_ENGINE="ollama"
RAG_EMBEDDING_MODEL="qwen3-embedding-4b-cpu:latest"
OLLAMA_BASE_URLS="http://172.17.0.1:11434"
CONTENT_EXTRACTION_ENGINE="docling"
DOCLING_SERVER_URL="http://docling:5001"
TOOL_SERVER_CONNECTIONS='[{"url":"http://mcpo:8000/fetch","path":"openapi.json","auth_type":"bearer","key":"","config":{"enable":true,"access_control":null}},{"url":"http://mcpo:8000/time","path":"openapi.json","auth_type":"bearer","key":"","config":{"enable":true,"access_control":null}},{"url":"http://mcpo:8000/sequential-thinking","path":"openapi.json","auth_type":"bearer","key":"","config":{"enable":true,"access_control":null}},{"url":"http://mcpo:8000/memory","path":"openapi.json","auth_type":"bearer","key":"","config":{"enable":true,"access_control":null}},{"url":"http://mcpo:8000/filesystem","path":"openapi.json","auth_type":"bearer","key":"","config":{"enable":true,"access_control":null}},{"url":"http://mcpo:8000/search","path":"openapi.json","auth_type":"bearer","key":"","config":{"enable":true,"access_control":null}},{"url":"http://mcpo:8000/git","path":"openapi.json","auth_type":"bearer","key":"","config":{"enable":true,"access_control":null}},{"url":"http://172.18.0.1:8210","path":"openapi.json","auth_type":"bearer","key":"","config":{"enable":true,"access_control":null}}]'
ENABLE_API_KEYS="True"
# Bound tool-server calls: without this they inherit AIOHTTP_CLIENT_TIMEOUT (900s)
# and a hung tool server pins the chat for 15 minutes.
AIOHTTP_CLIENT_TIMEOUT_TOOL_SERVER=120
HARBOR_OPENAI_URLS=http://172.18.0.1:4000/v1;http://172.17.0.1:8091/v1;http://172.17.0.1:8093/v1;http://172.17.0.1:8094/v1
VECTOR_DB=qdrant
QDRANT_URI=http://qdrant:6333
