qdrant/storage

# Merged compose
__harbor*.yml

# Migration backups
.migration-backup-*

# Operator-side ad-hoc backups (auto-created snapshots: *.bak, *.bak.<tag>, *.bak-<tag>)
backups/
*.bak
*.bak-*
*.bak.*

.cache
.local
.npm
.pkgx

# Skills
skills-lock.json

# Claude local runtime state
.claude/scheduled_tasks.lock

# Lemonade
lemonade/cache/
lemonade/llama/

# Parcel
.parcel-cache
# Local secret overrides (untracked) — added by secrets audit 2026-05-27
**/*.local.env

