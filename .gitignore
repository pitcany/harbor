# Jupyter
jupyter/workspace/*
!jupyter/workspace/000-sample.ipynb

# History
.history

# Boost
**/__pycache__/

# AnythingLLM
anythingllm/storage/

# Build
dist/

# Aider
.aider.chat.history.md

# Open WebUI Pipelines
pipelines/*
!pipelines/override.env

# Qdrant
qdrant/storage
# The rule above is anchored to the repo root, so it never matched the real
# vector store under services/.
services/qdrant/storage/

# Merged compose
__harbor*.yml

# Migration backups
.migration-backup-*

# Operator-side ad-hoc backups (auto-created snapshots: *.bak, *.bak.<tag>, *.bak-<tag>)
backups/
*.bak
*.bak-*
*.bak.*

.cache
.local
.npm
.pkgx

# Skills
skills-lock.json

# Claude local runtime state
.claude/scheduled_tasks.lock

# Lemonade
lemonade/cache/
lemonade/llama/

# Parcel
.parcel-cache
# Local secret overrides (untracked) — added by secrets audit 2026-05-27
**/*.local.env
# Machine-local service configs that carry secrets. searxng's settings.local.yml
# holds the paid Brave Search API key: this searxng build has no per-engine env
# override, so the key has to live in the settings file, and that file must
# therefore never be tracked. See services/searxng/override.local.env.
**/*.local.yml

# Test artifacts (per-run logs from `harbor dev test`; spec keeps these out of git).
tests/artifacts/
# Integration test artifacts
integration/

# Skill-creator runtime scripts
.agents/skills/skill-creator/scripts/
