# Local .env
.env

# Python
.venv

# Node
node_modules/

# Deno
.deno-cache/

# Open WebUI (old)
open-webui/*
open-webui/config.json

!open-webui/configs/
!open-webui/extras/
!open-webui/start_webui.sh
!open-webui/override.env

# Open WebUI (new, in services)
services/webui/*
services/webui/config.json

!services/webui/configs/
!services/webui/extras/
!services/webui/seeds/
!services/webui/start_webui.sh
!services/webui/webui.env
# override.env is intentionally NOT tracked — it holds the gateway sk- secret
# (untracked 2026-06-14). It stays under the services/webui/* ignore above.
# Non-secret WebUI env settings live in the tracked webui.env (allowed above).

# Open WebUI (new, in root)
webui/*
webui/config.json

!webui/configs/
!webui/extras/
!webui/start_webui.sh
!webui/override.env

# Ollama
/ollama/ollama/

# Openedai Speech
tts/voices/

# General
node_modules/

# langfuse
langfuse/db/

scripts/*
# ...except the Open WebUI tool-use diagnostic and regression suite, which
# artifacts/operator_runbook.md documents by path.
!scripts/diagnose_openwebui_tools.sh
!scripts/test_openwebui_tools.sh
!scripts/owui_tool_harness.py
!scripts/mock_tool_server.py
!scripts/toolserver_config.py
!scripts/scenarios_baseline.json
!scripts/scenarios_ui_native.json
!scripts/probe_tool_parser.py
!scripts/bench_decode.py
!scripts/measure_tool_output_sizes.py
!scripts/demos/

# LiteLLM
litellm/db

# Plandex
plandex/data
plandex/db

# Dify
dify/volumes/
services/dify/nginx/conf.d/default.conf

